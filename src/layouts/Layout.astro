---
import '@fontsource/faculty-glyphic/latin-400.css';
import '@fontsource/dm-mono/latin-400.css';
import '@fontsource/dm-mono/latin-500.css';
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-500.css';
import '@fontsource/permanent-marker/latin-400.css';
import '../styles/global.css';
import { site } from '../data/site';
import { seo } from '../data/seo';
import { withBase } from '../lib/paths';
import {
  absoluteUrl,
  formatPageTitle,
  serializeJsonLd,
} from '../lib/seo';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  pageClass?: string;
  hideFooter?: boolean;
  hideNav?: boolean;
}

const {
  title,
  description = seo.defaultDescription,
  image = seo.defaultOgImage,
  imageAlt = seo.defaultOgImageAlt,
  type = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
  jsonLd,
  pageClass,
  hideFooter = false,
  hideNav = false,
} = Astro.props;

const pageTitle = formatPageTitle(title, site.title);
const canonical = absoluteUrl(Astro.url.pathname);
const ogImage = absoluteUrl(image);
const twitterCard = image ? 'summary_large_image' : 'summary';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'}
    />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={seo.siteName} />
    <meta property="og:locale" content={seo.locale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {
      type === 'article' && publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    {
      type === 'article' && modifiedTime && (
        <meta property="article:modified_time" content={modifiedTime} />
      )
    }
    {
      type === 'article' && (
        <meta property="article:author" content={seo.person.name} />
      )
    }

    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32.png')} />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="any" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <meta name="generator" content={Astro.generator} />

    {
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={serializeJsonLd(jsonLd)}
        />
      )
    }
  </head>
  <body>
    <div class:list={['page', pageClass]}>
      {!hideNav && <Nav />}
      <slot />
      {!hideFooter && <Footer />}
    </div>
  </body>
</html>
