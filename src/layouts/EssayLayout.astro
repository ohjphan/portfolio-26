---
import Layout from './Layout.astro';
import HandDrawnDivider from '../components/HandDrawnDivider.astro';
import SketchLink from '../components/SketchLink.astro';
import SketchIcon from '../components/SketchIcon.astro';
import EssayCard from '../components/EssayCard.astro';
import { withBase } from '../lib/paths';
import type { CollectionEntry } from 'astro:content';

interface Props {
  essay: CollectionEntry<'essays'>;
  related?: CollectionEntry<'essays'>[];
}

const { essay, related = [] } = Astro.props;
const { title, category, tldr, publication, publicationUrl, cover, coverAlt } =
  essay.data;
---

<Layout title={title} description={essay.data.description}>
  <article>
    <header class="essay-header">
      {
        cover && (
          <figure class="essay-cover" data-mosaic-scroll>
            <img
              class="essay-cover__image"
              src={withBase(cover)}
              alt={coverAlt ?? ''}
              width="1200"
              height="900"
              loading="eager"
              decoding="async"
            />
          </figure>
        )
      }
      <p class="essay-category" data-category={category}>{category}</p>
      <h1 class="essay-title">{title}</h1>
      {
        publication && (
          <p class="essay-publication">
            {publicationUrl ? (
              <>
                Written for{' '}
                <SketchLink href={publicationUrl} external>
                  {publication}
                </SketchLink>
              </>
            ) : (
              <>Written for {publication}</>
            )}
          </p>
        )
      }
      <aside class="essay-tldr" aria-label="TLDR">
        <div class="essay-tldr__heading">
          <span class="essay-tldr__icon" aria-hidden="true">
            <SketchIcon name="note" />
          </span>
          <p class="essay-tldr__label">TLDR</p>
        </div>
        <p class="essay-tldr__text">{tldr}</p>
      </aside>
    </header>

    <div class="prose">
      <slot />
    </div>

    {
      related.length > 0 && (
        <aside class="related-section related-section--essays">
          <HandDrawnDivider />
          <h2 class="related-title">Continue reading</h2>
          <div class="essay-grid">
            {related.map((item) => (
              <EssayCard
                title={item.data.title}
                description={item.data.description}
                category={item.data.category}
                href={`/writing/${item.id}`}
                cover={item.data.cover}
                coverAlt={item.data.coverAlt}
              />
            ))}
          </div>
        </aside>
      )
    }
  </article>
</Layout>

<script>
  import { observeWritingMosaics } from '../lib/mosaic-reveal';
  observeWritingMosaics();
</script>
