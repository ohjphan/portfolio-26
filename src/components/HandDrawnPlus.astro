---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class:list={['hand-drawn-plus', className]}
  viewBox="0 0 20 20"
  aria-hidden="true"
>
  <path
    class="hand-drawn-mark__path"
    d="M 10,2 C 9,7 11,13 10,18"
    pathLength="100"
  />
  <path
    class="hand-drawn-mark__path"
    d="M 2,10 C 7,9 13,11 18,10"
    pathLength="100"
  />
  <path
    class="hand-drawn-mark__path hand-drawn-mark__path--accent"
    d="M 9,9 C 8,10 10,11 11,10"
    pathLength="100"
  />
</svg>
