---
import SketchLink from './SketchLink.astro';
import { withBase } from '../lib/paths';

interface DetailSegment {
  text: string;
  href?: string;
  external?: boolean;
}

interface FunFact {
  image: string;
  imageAlt: string;
  headline: string;
  detail: string | { segments: readonly DetailSegment[] };
}

interface Props {
  items: readonly FunFact[];
}

const { items } = Astro.props;
---

<ul class="fun-facts" role="list">
  {
    items.map((item) => (
      <li class="fun-facts__item">
        <figure class="fun-facts__card">
          <div class="fun-facts__media">
            <img
              src={withBase(item.image)}
              alt={item.imageAlt}
              width="640"
              height="480"
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption class="fun-facts__caption">
            <p class="fun-facts__headline">{item.headline}</p>
            <p class="fun-facts__detail">
              {typeof item.detail === 'string' ? (
                item.detail
              ) : (
                item.detail.segments.map((segment) =>
                  segment.href ? (
                    <SketchLink href={segment.href} external={segment.external}>
                      {segment.text}
                    </SketchLink>
                  ) : (
                    segment.text
                  ),
                )
              )}
            </p>
          </figcaption>
        </figure>
      </li>
    ))
  }
</ul>
