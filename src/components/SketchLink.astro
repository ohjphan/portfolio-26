---
import HandDrawnLinkStroke from './HandDrawnLinkStroke.astro';
import { withBase } from '../lib/paths';

interface Props {
  href: string;
  class?: string;
  external?: boolean;
  'aria-current'?: 'page' | undefined;
}

const {
  href,
  class: className,
  external = false,
  'aria-current': ariaCurrent,
} = Astro.props;

const resolvedHref = external ? href : withBase(href);
---

<a
  href={resolvedHref}
  class:list={['sketch-link', className]}
  aria-current={ariaCurrent}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <span class="sketch-link__label"><slot /></span>
  <HandDrawnLinkStroke />
</a>
