---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div
  class:list={['hand-drawn-divider', className]}
  role="separator"
  aria-hidden="true"
>
  <svg viewBox="0 0 400 8" preserveAspectRatio="none">
    <path
      class="hand-drawn-divider__path"
      d="M 2,4 C 48,2 96,6 144,4 S 240,2 288,5 S 352,3 398,4"
      pathLength="100"
    />
    <path
      class="hand-drawn-divider__path hand-drawn-divider__path--accent"
      d="M 0,5 C 52,3 104,6 156,4 S 260,3 312,5 S 364,4 400,5"
      pathLength="100"
    />
  </svg>
</div>
