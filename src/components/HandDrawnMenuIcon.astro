---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class:list={['hand-drawn-menu', className]}
  viewBox="0 0 28 28"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <!-- Vertical stem -->
  <path
    class="hand-drawn-menu__stroke"
    d="M 13.6,2.2 C 12.8,7.4 14.8,13.2 13.9,19.1 C 13.5,22.4 14.4,25.2 14.2,26.4"
    pathLength="100"
  />
  <!-- Horizontal crossbar -->
  <path
    class="hand-drawn-menu__stroke"
    d="M 2.1,13.7 C 7.4,12.6 12.8,15.1 18.6,13.5 C 22.1,12.6 25.2,14 26.3,14.3"
    pathLength="100"
  />
  <!-- Light second-pass accents for sketch feel -->
  <path
    class="hand-drawn-menu__stroke hand-drawn-menu__stroke--accent"
    d="M 14.8,3.1 C 14.2,8.6 15.6,14.4 14.9,20.2 C 14.6,23.1 15.2,25.4 15.1,26.1"
    pathLength="100"
  />
  <path
    class="hand-drawn-menu__stroke hand-drawn-menu__stroke--accent"
    d="M 3,14.8 C 8.2,13.9 13.4,15.9 19.1,14.4 C 22.4,13.6 25,14.8 25.8,15.1"
    pathLength="100"
  />
</svg>
