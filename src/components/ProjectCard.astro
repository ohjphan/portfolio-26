---
import HandDrawnLinkStroke from './HandDrawnLinkStroke.astro';
import { withBase } from '../lib/paths';

interface Props {
  title: string;
  description: string;
  href: string;
  category?: string;
  organization: string;
  variant?: 'featured' | 'grid';
  illustration?: string;
  illustrationAlt?: string;
}

const {
  title,
  description,
  href,
  category,
  organization,
  variant = 'grid',
  illustration,
  illustrationAlt = '',
} = Astro.props;

const isFeatured = variant === 'featured';
const showThumb = Boolean(illustration);
---

<article
  class:list={[
    'project-card',
    isFeatured && 'project-card--featured',
    !isFeatured && showThumb && 'project-card--thumb',
  ]}
  data-category={category}
>
  <a href={withBase(href)} class="project-card__link">
    <div class="project-card__face" data-category={category}>
      {
        isFeatured && showThumb && (
          <div class="project-card__media">
            <img
              src={withBase(illustration!)}
              alt={illustrationAlt}
              width="480"
              height="480"
              loading="lazy"
              decoding="async"
            />
          </div>
        )
      }
      {
        !isFeatured && showThumb && (
          <div class="project-card__thumb">
            <img
              src={withBase(illustration!)}
              alt={illustrationAlt}
              width="960"
              height="640"
              loading="lazy"
              decoding="async"
            />
          </div>
        )
      }
      <div class="project-card__content">
        {category && <p class="project-card__category">{category}</p>}
        <h3 class="project-card__title">
          <span class="project-card__title-sketch">
            <span class="project-card__title-text">{organization}</span>
            <HandDrawnLinkStroke />
          </span>
        </h3>
        <p class="project-card__description">{description}</p>
      </div>
    </div>
  </a>
</article>
