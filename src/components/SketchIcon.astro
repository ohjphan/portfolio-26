---
interface Props {
  name: string;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  class:list={['sketch-icon', className]}
  viewBox="0 0 64 64"
  fill="none"
  aria-hidden="true"
>
  {
    name === 'spiral' && (
      <path
        class="sketch-icon__path"
        d="M32,32 C32,24 38,20 44,22 C52,25 54,36 48,44 C40,54 24,54 18,44 C10,32 16,16 30,14 C46,12 56,26 52,40"
        pathLength="100"
      />
    )
  }
  {
    name === 'lens' && (
      <>
        <path
          class="sketch-icon__path"
          d="M18,20 C16,28 16,36 18,44 C26,48 38,48 46,44 C48,36 48,28 46,20 C38,16 26,16 18,20"
