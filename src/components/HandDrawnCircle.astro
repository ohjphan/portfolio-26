---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class:list={['hand-drawn-circle', className]}
  viewBox="0 0 20 20"
  aria-hidden="true"
>
  <path
    class="hand-drawn-mark__path"
    d="M 10,3 C 14,2 18,6 18,10 C 18,14 14,18 10,17 C 6,18 2,14 3,10 C 2,6 6,2 10,3 C 9,2 8,3 9,4"
    pathLength="100"
  />
  <path
    class="hand-drawn-mark__path hand-drawn-mark__path--accent"
    d="M 4,12 C 3,10 4,8 6,9"
    pathLength="100"
  />
</svg>
