---
import { withBase } from '../lib/paths';

/**
 * Homepage hero collage portrait (transparent background).
 */
const width = 700;
const height = 682;
---

<figure class="home-portrait">
  <img
    class="home-portrait__image"
    src={withBase('/images/jessica-hero-portrait-collage.png')}
    alt="Collage portrait of Jessica resting her chin on her hand, layered with torn blue, orange, and purple paper shapes"
    width={width}
    height={height}
    decoding="async"
    fetchpriority="high"
  />
</figure>
