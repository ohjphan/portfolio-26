---
import type { SelectedWorkSlide } from '../data/selected-work';

interface Props {
  slides: readonly SelectedWorkSlide[];
}

const { slides } = Astro.props;
const total = slides.length;
import { withBase } from '../lib/paths';
---

{
  total > 0 && (
    <div
      class="selected-works in-five in-five--presentation"
      data-selected-works
      data-total={total}
    >
      <div class="in-five__stage">
        {slides.map((slide, index) => (
          <figure
            class:list={['in-five__slide', index === 0 && 'is-active']}
            data-slide={index}
            aria-hidden={index === 0 ? 'false' : 'true'}
          >
            <div class="in-five__media selected-works__media">
              <img
                src={withBase(slide.image)}
                alt={`${slide.company} — ${slide.project}. ${slide.imageAlt}`}
                width="1600"
                height="900"
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </div>
            {
              slide.summary && (
                <figcaption class="in-five__caption selected-works__caption">
                  <p class="selected-works__summary">{slide.summary}</p>
                </figcaption>
              )
            }
          </figure>
        ))}

        <div class="in-five__chrome">
          <button
            type="button"
            class="in-five__nav in-five__nav--prev"
            data-prev
            aria-label="Previous work"
          >
            <span aria-hidden="true">←</span>
          </button>

          <div class="in-five__status">
            <p class="in-five__progress" aria-live="polite">
              <span data-progress-current>1</span>
              <span class="in-five__progress-sep" aria-hidden="true">/</span>
              <span>{total}</span>
            </p>
            <div
              class="in-five__dots"
              role="tablist"
              aria-label="Selected works"
            >
              {slides.map((slide, index) => (
                <button
                  type="button"
                  class:list={['in-five__dot', index === 0 && 'is-active']}
                  role="tab"
                  aria-selected={index === 0 ? 'true' : 'false'}
                  aria-label={`${slide.company}: ${slide.project}`}
                  data-goto={index}
                />
              ))}
            </div>
          </div>

          <button
            type="button"
            class="in-five__nav in-five__nav--next"
            data-next
            aria-label="Next work"
          >
            <span aria-hidden="true">→</span>
          </button>
        </div>
      </div>
    </div>
  )
}

<script is:inline>
  (() => {
    const root = document.querySelector('[data-selected-works]');
    if (!root) return;

    const slides = [...root.querySelectorAll('[data-slide]')];
    const dots = [...root.querySelectorAll('[data-goto]')];
    const prev = root.querySelector('[data-prev]');
    const next = root.querySelector('[data-next]');
    const progress = root.querySelector('[data-progress-current]');
    if (slides.length === 0) return;

    let index = 0;
    let timer = null;
    const intervalMs = 5000;
    const reduceMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches;

    const show = (nextIndex) => {
      index = (nextIndex + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        const active = i === index;
        slide.classList.toggle('is-active', active);
        slide.setAttribute('aria-hidden', active ? 'false' : 'true');
      });
      dots.forEach((dot, i) => {
        const active = i === index;
        dot.classList.toggle('is-active', active);
        dot.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      if (progress) progress.textContent = String(index + 1);
    };

    const stop = () => {
      if (timer !== null) {
        window.clearInterval(timer);
        timer = null;
      }
    };

    const start = () => {
      if (reduceMotion || slides.length < 2) return;
      stop();
      timer = window.setInterval(() => show(index + 1), intervalMs);
    };

    const nudge = (nextIndex) => {
      show(nextIndex);
      start();
    };

    prev?.addEventListener('click', () => nudge(index - 1));
    next?.addEventListener('click', () => nudge(index + 1));
    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        nudge(Number(dot.getAttribute('data-goto')));
      });
    });

    root.addEventListener('keydown', (event) => {
      if (!(event instanceof KeyboardEvent)) return;
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        nudge(index + 1);
      } else if (event.key === 'ArrowLeft') {
        event.preventDefault();
        nudge(index - 1);
      }
    });

    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', (event) => {
      if (!root.contains(event.relatedTarget)) start();
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else start();
    });

    start();
  })();
</script>
