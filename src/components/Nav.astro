---
import { site } from '../data/site';
import { stripBase, withBase } from '../lib/paths';
import NavLink from './NavLink.astro';
import HandDrawnCircleStroke from './HandDrawnCircleStroke.astro';
import HandDrawnLinkStroke from './HandDrawnLinkStroke.astro';
import JessicaMark from './JessicaMark.astro';

const pathname = stripBase(Astro.url.pathname);
const homeCurrent = pathname === '/';
---

<nav class="site-nav" aria-label="Main">
  <a
    href={withBase('/')}
    class="nav-link eyebrow site-nav__home"
    aria-current={homeCurrent ? 'page' : undefined}
    aria-label={site.title}
  >
    <span class="site-nav__brand">
      <JessicaMark class="site-nav__mark" />
      <span class="nav-link__label">{site.title}</span>
    </span>
    <HandDrawnCircleStroke />
    <span class="nav-link__underline">
      <HandDrawnLinkStroke />
    </span>
  </a>

  <ul class="nav-list">
    {
      site.nav.map(({ label, href }) => (
        <li>
          <NavLink
            href={withBase(href)}
            label={label}
            current={pathname.startsWith(href) && href !== '/'}
          />
        </li>
      ))
    }
  </ul>
</nav>
