---
import {
  isLightBrand,
  type SelectedWorkItem,
} from '../data/selected-work';

interface Props {
  items: SelectedWorkItem[];
  title?: string;
  intro?: string;
}

const {
  items,
  title,
  intro,
} = Astro.props;

const ariaLabel = title || intro || 'Companies I\u2019ve worked with';
---

<section class="logo-garden" aria-label={ariaLabel}>
  {title && <p class="section-title">{title}</p>}
  {
    intro && (
      <p class="logo-garden__intro text-muted">{intro}</p>
    )
  }
  <ul class="logo-garden__grid">
    {
      items.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              'logo-garden__card',
              isLightBrand(item.color) && 'logo-garden__card--light',
            ]}
            style={`--brand: ${item.color}; --logo-scale: ${item.logoScale ?? 1}`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${item.label}, ${item.category}`}
          >
            <span class="logo-garden__category">{item.category}</span>
            {item.logo ? (
              <img
                class="logo-garden__logo"
                src={item.logo}
                alt=""
                loading="lazy"
              />
            ) : (
              <span class="logo-garden__mark">{item.label}</span>
            )}
          </a>
        </li>
      ))
    }
  </ul>
</section>
