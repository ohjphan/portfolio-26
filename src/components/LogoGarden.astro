---
import {
  isLightBrand,
  type SelectedWorkItem,
} from '../data/selected-work';

interface Props {
  items: SelectedWorkItem[];
  title?: string;
  intro?: string;
  id?: string;
}

const {
  items,
  title,
  intro,
  id,
} = Astro.props;

const ariaLabel = title || intro || 'Companies I\u2019ve worked with';
import { withBase } from '../lib/paths';
---

<section
  class="logo-garden"
  id={id}
  aria-label={title ? undefined : ariaLabel}
  aria-labelledby={title && id ? `${id}-title` : undefined}
>
  {
    title && (
      <h2 class="jessica-band__title" id={id ? `${id}-title` : undefined}>
        {title}
      </h2>
    )
  }
  {
    intro && (
      <p class="logo-garden__intro text-muted">{intro}</p>
    )
  }
  <ul class="logo-garden__grid">
    {
      items.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              'logo-garden__card',
              isLightBrand(item.color) && 'logo-garden__card--light',
            ]}
            style={`--brand: ${item.color}; --logo-scale: ${item.logoScale ?? 1}`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${item.label}, ${item.category}`}
          >
            <span class="logo-garden__category">{item.category}</span>
            {item.logo ? (
              <img
                class="logo-garden__logo"
                src={withBase(item.logo)}
                alt=""
                loading="lazy"
              />
            ) : (
              <span class="logo-garden__mark">{item.label}</span>
            )}
          </a>
        </li>
      ))
    }
  </ul>
</section>
