---
import Layout from '../../layouts/Layout.astro';
import LogoGarden from '../../components/LogoGarden.astro';
import SelectedWorks from '../../components/SelectedWorks.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import HandDrawnDivider from '../../components/HandDrawnDivider.astro';
import HandDrawnCircleStroke from '../../components/HandDrawnCircleStroke.astro';
import HandDrawnLinkStroke from '../../components/HandDrawnLinkStroke.astro';
import { getCollection } from 'astro:content';
import {
  aiWorkSlides,
  selectedWorkLogos,
  selectedWorkSlides,
} from '../../data/selected-work';
import { withBase } from '../../lib/paths';

const published = (
  await getCollection('projects', ({ data }) => !data.draft)
).sort((a, b) => {
  const orderA = a.data.order ?? Infinity;
  const orderB = b.data.order ?? Infinity;
  if (orderA !== orderB) return orderA - orderB;
  return a.data.title.localeCompare(b.data.title);
});

const experiments = published.filter(
  (project) => project.data.category === 'Experiments',
);

const sections = [
  { label: 'Companies', href: '#companies' },
  ...(aiWorkSlides.length > 0 ? [{ label: 'AI', href: '#ai' }] : []),
  ...(selectedWorkSlides.length > 0
    ? [{ label: 'Works', href: '#works' }]
    : []),
  ...(experiments.length > 0
    ? [{ label: 'Experiments', href: '#experiments' }]
    : []),
];
---

<Layout
  title="Creating"
  description="Selected product, brand, and AI design work by Jessica Phan — from early-stage startups and hypergrowth teams to experiments built for curiosity."
>
  <header class="creating-hero">
    <h1 class="heading-lg">Creating</h1>
    <p class="text-muted creating-hero__intro">
      Product, brand, and AI design work across early-stage startups,
      hypergrowth teams, enterprise, and personal experiments.
    </p>
  </header>

  <nav class="page-subnav" aria-label="Creating sections" data-creating-subnav>
    {
      sections.map(({ label, href }, index) => (
        <a
          href={href}
          class:list={['page-subnav__link', index === 0 && 'is-active']}
          data-subnav-link
        >
          <span class="page-subnav__label">{label}</span>
          <HandDrawnCircleStroke />
          <span class="page-subnav__underline">
            <HandDrawnLinkStroke />
          </span>
        </a>
      ))
    }
  </nav>

  <LogoGarden
    id="companies"
    items={selectedWorkLogos}
    title="Companies"
  />

  {
    aiWorkSlides.length > 0 && (
      <>
        <HandDrawnDivider />
        <section id="ai" class="creating-ai" aria-labelledby="ai-title">
          <header class="creating-ai__header">
            <h2 id="ai-title" class="jessica-band__title">
              AI
            </h2>
            <p class="creating-ai__intro text-muted">
              Designing for AI platforms means earning trust, clarifying first
              actions, and making complex systems feel usable — without hiding
              the hard parts.
            </p>
          </header>
          <ul class="creating-ai__grid" role="list">
            {aiWorkSlides.map((slide) => (
              <li>
                <a class="creating-ai__card" href="#works">
                  <div class="creating-ai__media" data-mosaic-scroll>
                    <img
                      src={withBase(slide.image)}
                      alt={slide.imageAlt}
                      width="960"
                      height="720"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <div class="creating-ai__copy">
                    <p class="creating-ai__company">{slide.company}</p>
                    <h3 class="creating-ai__project">{slide.project}</h3>
                    {slide.summary && (
                      <p class="creating-ai__summary">{slide.summary}</p>
                    )}
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </section>
      </>
    )
  }

  {
    selectedWorkSlides.length > 0 && (
      <>
        <HandDrawnDivider />
        <section
          id="works"
          class="creating-selected"
          aria-labelledby="works-title"
        >
          <header class="creating-selected__header">
            <h2 id="works-title" class="jessica-band__title">
              Works
            </h2>
          </header>
          <SelectedWorks works={selectedWorkSlides} />
        </section>
      </>
    )
  }

  {
    experiments.length > 0 && (
      <>
        <HandDrawnDivider />
        <section class="creating-experiments" id="experiments" aria-labelledby="experiments-title">
          <header class="creating-experiments__header">
            <h2 id="experiments-title" class="jessica-band__title">
              Experiments
            </h2>
            <p class="creating-experiments__intro text-muted">
              “Play is the highest form of research.” Einstein wasn’t wrong.
              These side builds and prototypes are my form of play — where I
              follow curiosity without a brief, and remember that making is
              how creative people stay alive to the work.
            </p>
          </header>
          <div class="project-grid">
            {experiments.map((project) => (
              <ProjectCard
                title={project.data.title}
                description={project.data.description}
                organization={project.data.organization}
                href={`/creating/${project.id}`}
                illustration={project.data.illustration}
                illustrationAlt={project.data.illustrationAlt}
              />
            ))}
          </div>
        </section>
      </>
    )
  }
</Layout>

<script>
  import { observeScrollMosaics } from '../../lib/mosaic-reveal';

  function bindCreatingSubnav() {
    const nav = document.querySelector<HTMLElement>('[data-creating-subnav]');
    if (!nav || nav.dataset.bound === 'true') return;
    nav.dataset.bound = 'true';

    const links = Array.from(
      nav.querySelectorAll<HTMLAnchorElement>('[data-subnav-link]'),
    );
    const sections = links
      .map((link) => {
        const id = link.getAttribute('href')?.slice(1);
        if (!id) return null;
        const section = document.getElementById(id);
        return section ? { link, section } : null;
      })
      .filter((item): item is { link: HTMLAnchorElement; section: HTMLElement } =>
        Boolean(item),
      );

    if (sections.length === 0) return;

    const setActive = (activeLink: HTMLAnchorElement) => {
      links.forEach((link) => {
        link.classList.toggle('is-active', link === activeLink);
      });
    };

    links.forEach((link) => {
      link.addEventListener('click', () => setActive(link));
    });

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio);
        const top = visible[0];
        if (!top?.target) return;
        const match = sections.find(({ section }) => section === top.target);
        if (match) setActive(match.link);
      },
      {
        rootMargin: '-35% 0px -50% 0px',
        threshold: [0.1, 0.25, 0.5],
      },
    );

    sections.forEach(({ section }) => observer.observe(section));
  }

  observeScrollMosaics();
  bindCreatingSubnav();
  document.addEventListener('astro:page-load', () => {
    observeScrollMosaics();
    bindCreatingSubnav();
  });
</script>
