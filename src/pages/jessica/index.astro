---
import Layout from '../../layouts/Layout.astro';
import HandDrawnDivider from '../../components/HandDrawnDivider.astro';
import JessicaSection from '../../components/JessicaSection.astro';
import FunFacts from '../../components/FunFacts.astro';
import SketchLink from '../../components/SketchLink.astro';
import SketchIcon from '../../components/SketchIcon.astro';
import HandDrawnCircleStroke from '../../components/HandDrawnCircleStroke.astro';
import HandDrawnLinkStroke from '../../components/HandDrawnLinkStroke.astro';
import { jessica } from '../../data/jessica';
import { profilePageJsonLd, professionalServiceJsonLd } from '../../lib/seo';
import { withBase } from '../../lib/paths';

const amazonUrl = (asin: string) =>
  `https://www.amazon.com/dp/${asin}?tag=${jessica.books.amazonTag}`;

const books = jessica.books.lenses.flatMap((lens) =>
  lens.items.map((book) => ({ ...book, lens: lens.label })),
);
const bookLoop = [...books, ...books];
---

<Layout
  title={jessica.meta.title}
  description={jessica.meta.description}
  image="/images/og/jessica.png"
  imageAlt="Collage portrait of Jessica Phan — Jessica is Jessica"
  jsonLd={[profilePageJsonLd(), professionalServiceJsonLd()]}
>
  <header class="jessica-hero">
    <h1 class="heading-lg">{jessica.hero.title}</h1>
    <p class="text-muted jessica-hero__intro">{jessica.hero.subheading}</p>
  </header>

  <nav class="page-subnav" aria-label="Jessica sections" data-page-subnav>
    <a href="#about" class="page-subnav__link is-active" data-subnav-link>
      <span class="page-subnav__label">About</span>
      <HandDrawnCircleStroke />
      <span class="page-subnav__underline">
        <HandDrawnLinkStroke />
      </span>
    </a>
    <a href="#guides" class="page-subnav__link" data-subnav-link>
      <span class="page-subnav__label">Guides</span>
      <HandDrawnCircleStroke />
      <span class="page-subnav__underline">
        <HandDrawnLinkStroke />
      </span>
    </a>
    <a href="#fun-facts" class="page-subnav__link" data-subnav-link>
      <span class="page-subnav__label">Fun facts</span>
      <HandDrawnCircleStroke />
      <span class="page-subnav__underline">
        <HandDrawnLinkStroke />
      </span>
    </a>
    <a href="#fav-books" class="page-subnav__link" data-subnav-link>
      <span class="page-subnav__label">Fav books</span>
      <HandDrawnCircleStroke />
      <span class="page-subnav__underline">
        <HandDrawnLinkStroke />
      </span>
    </a>
  </nav>

  <JessicaSection id="about" title={jessica.about.label}>
    <div class="jessica-about-layout">
      <div class="jessica-about-layout__copy">
        <div class="prose jessica-about">
          {
            jessica.about.paragraphs.map((paragraph) => (
              <p>
                {typeof paragraph === 'string' ? (
                  paragraph
                ) : (
                  paragraph.segments.map((segment) =>
                    'href' in segment ? (
                      <SketchLink href={segment.href}>{segment.text}</SketchLink>
                    ) : (
                      segment.text
                    ),
                  )
                )}
              </p>
            ))
          }
        </div>
      </div>
      <figure class="jessica-about-layout__portrait" data-jessica-collage>
        <div class="jessica-collage" data-mosaic-scroll>
          <img
            class="jessica-collage__image"
            src={withBase("/images/jessica/about-collage.png")}
            alt="Collage portrait of Jessica smiling, layered with torn paper, a microphone, an open book, jewelry, and a winding blue path"
            width="1024"
            height="682"
            loading="lazy"
            decoding="async"
          />
        </div>
      </figure>
    </div>
  </JessicaSection>

  <HandDrawnDivider />

  <JessicaSection id="guides" title={jessica.guides.label}>
    <ul class="guides-list" role="list">
      {
        jessica.guides.items.map((item) => (
          <li class="guides-list__item">
            <div class="guides-list__icon" aria-hidden="true">
              <SketchIcon name={item.icon} />
            </div>
            <h3 class="guides-list__title">{item.title}</h3>
            <p class="guides-list__body">{item.body}</p>
          </li>
        ))
      }
    </ul>
  </JessicaSection>

  <HandDrawnDivider />

  <JessicaSection id="fun-facts" title={jessica.funFacts.label}>
    <FunFacts items={jessica.funFacts.items} />
  </JessicaSection>

  <HandDrawnDivider />

  <JessicaSection id="fav-books" title="A few favorite books">
    <p class="jessica-section__lede">{jessica.books.lede}</p>
    <div class="book-filters" role="group" aria-label="Filter books by lens">
      {
        jessica.books.lenses.map((lens) => (
          <button
            type="button"
            class="essay-filter book-filter"
            data-filter={lens.label}
          >
            <span class="essay-filter__label">{lens.label}</span>
            <HandDrawnCircleStroke />
            <span class="essay-filter__underline">
              <HandDrawnLinkStroke />
            </span>
          </button>
        ))
      }
    </div>
    <div class="book-shelf" data-book-shelf>
      <div class="book-shelf__viewport">
        <ul class="book-shelf__track" role="list">
          {
            bookLoop.map((book, index) => (
              <li
                class="book-shelf__item"
                data-lens={book.lens}
                data-book-duplicate={index >= books.length ? 'true' : undefined}
                aria-hidden={index >= books.length ? 'true' : undefined}
              >
                <a
                  class="book-shelf__cover-link"
                  href={amazonUrl(book.asin)}
                  target="_blank"
                  rel="noopener noreferrer sponsored"
                  tabindex={index >= books.length ? -1 : undefined}
                  aria-label={`View ${book.title} on Amazon`}
                >
                  <div class="book-shelf__media">
                    <img
                      class="book-shelf__cover"
                      src={withBase(book.image)}
                      alt={book.imageAlt}
                      width="240"
                      height="360"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <div class="book-shelf__caption">
                    <p class="book-shelf__title">{book.title}</p>
                    <p class="book-shelf__author">{book.author}</p>
                  </div>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </JessicaSection>

  <HandDrawnDivider />

  <JessicaSection title={jessica.explore.label}>
    <ul class="explore-paths" role="list">
      {
        jessica.explore.items.map((item) => (
          <li class="explore-paths__item">
            <a
              class="explore-paths__link"
              href={withBase(item.href)}
              data-accent={item.accent}
            >
              <div class="explore-paths__copy">
                <h3 class="explore-paths__title">
                  <span class="explore-paths__title-sketch">
                    <span class="explore-paths__title-text">{item.title}</span>
                    <HandDrawnLinkStroke />
                  </span>
                </h3>
                <p class="explore-paths__description">{item.description}</p>
              </div>
              <span class="explore-paths__arrow" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </JessicaSection>
</Layout>

<script>
  import { observeScrollMosaics } from '../../lib/mosaic-reveal';

  function bindPageSubnav(root: ParentNode = document) {
    const nav = root.querySelector<HTMLElement>('[data-page-subnav]');
    if (!nav || nav.dataset.bound === 'true') return;
    nav.dataset.bound = 'true';

    const links = Array.from(
      nav.querySelectorAll<HTMLAnchorElement>('[data-subnav-link]'),
    );
    const sections = links
      .map((link) => {
        const id = link.getAttribute('href')?.slice(1);
        if (!id) return null;
        const section = document.getElementById(id);
        return section ? { link, section } : null;
      })
      .filter((item): item is { link: HTMLAnchorElement; section: HTMLElement } =>
        Boolean(item),
      );

    if (sections.length === 0) return;

    const setActive = (activeLink: HTMLAnchorElement) => {
      links.forEach((link) => {
        link.classList.toggle('is-active', link === activeLink);
      });
    };

    links.forEach((link) => {
      link.addEventListener('click', () => setActive(link));
    });

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio);
        const top = visible[0];
        if (!top?.target) return;
        const match = sections.find(({ section }) => section === top.target);
        if (match) setActive(match.link);
      },
      {
        rootMargin: '-35% 0px -50% 0px',
        threshold: [0.1, 0.25, 0.5],
      },
    );

    sections.forEach(({ section }) => observer.observe(section));
  }

  observeScrollMosaics();
  bindPageSubnav();

  function bindJessicaCollage(root: ParentNode = document) {
    const reduceMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches;
    if (reduceMotion) return;

    root
      .querySelectorAll<HTMLElement>('[data-jessica-collage]')
      .forEach((host) => {
        if (host.dataset.parallaxBound === 'true') return;
        host.dataset.parallaxBound = 'true';

        const stage = host.querySelector<HTMLElement>('.jessica-collage');
        if (!stage) return;

        let raf = 0;
        let targetX = 0;
        let targetY = 0;
        let currentX = 0;
        let currentY = 0;

        const tick = () => {
          currentX += (targetX - currentX) * 0.08;
          currentY += (targetY - currentY) * 0.08;
          stage.style.setProperty('--parallax-x', `${currentX.toFixed(2)}px`);
          stage.style.setProperty('--parallax-y', `${currentY.toFixed(2)}px`);
          raf = window.requestAnimationFrame(tick);
        };

        const onMove = (event: PointerEvent) => {
          const rect = host.getBoundingClientRect();
          const nx = ((event.clientX - rect.left) / rect.width) * 2 - 1;
          const ny = ((event.clientY - rect.top) / rect.height) * 2 - 1;
          targetX = nx * 10;
          targetY = ny * 7;
        };

        const onLeave = () => {
          targetX = 0;
          targetY = 0;
        };

        host.addEventListener('pointermove', onMove);
        host.addEventListener('pointerleave', onLeave);
        raf = window.requestAnimationFrame(tick);
      });
  }

  function bindBookFilters(root: ParentNode = document) {
    const shelf = root.querySelector<HTMLElement>('[data-book-shelf]');
    const filters = root.querySelector<HTMLElement>('.book-filters');
    if (!shelf || !filters || filters.dataset.bound === 'true') return;
    filters.dataset.bound = 'true';

    const buttons = Array.from(
      filters.querySelectorAll<HTMLButtonElement>('.book-filter'),
    );
    const items = Array.from(
      shelf.querySelectorAll<HTMLElement>('.book-shelf__item'),
    );
    const viewport = shelf.querySelector<HTMLElement>('.book-shelf__viewport');

    const applyFilter = (filter: string | null) => {
      const active = Boolean(filter);
      buttons.forEach((button) => {
        button.classList.toggle(
          'is-active',
          active && button.getAttribute('data-filter') === filter,
        );
      });

      items.forEach((item) => {
        const lens = item.getAttribute('data-lens');
        const isDuplicate = item.hasAttribute('data-book-duplicate');
        const matches = !filter || lens === filter;
        const visible = matches && (!filter || !isDuplicate);
        item.toggleAttribute('hidden', !visible);
      });

      viewport?.classList.toggle('is-filtered', active);
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const next = button.getAttribute('data-filter');
        const alreadyActive = button.classList.contains('is-active');
        applyFilter(alreadyActive ? null : next);
      });
    });
  }

  bindJessicaCollage();
  bindBookFilters();
  document.addEventListener('astro:page-load', () => {
    observeScrollMosaics();
    bindPageSubnav();
    bindJessicaCollage();
    bindBookFilters();
  });
</script>
