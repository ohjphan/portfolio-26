---
import Layout from '../../layouts/Layout.astro';
import HandDrawnDivider from '../../components/HandDrawnDivider.astro';
import HandDrawnLinkStroke from '../../components/HandDrawnLinkStroke.astro';
import { talking } from '../../data/talking';
import { site } from '../../data/site';
import { withBase } from '../../lib/paths';
---

<Layout title={talking.meta.title} description={talking.meta.description}>
  <header class="talking-hero">
    <h1 class="heading-lg">{talking.hero.title}</h1>
    <p class="text-muted talking-hero__intro">{talking.hero.intro}</p>
  </header>

  <figure class="talking-feature">
    <img
      class="talking-feature__image"
      src={withBase("/images/talking/ideation-sketching-workshop-melbourne.png")}
      alt="Torn-paper collage of Jessica speaking into a mic at a workshop, with audience sketches and floating design diagrams on blue and red scraps"
      width="1024"
      height="682"
      loading="eager"
      decoding="async"
    />
  </figure>

  <section class="talking-section" aria-label="Talks and workshops">
    <ul class="talk-list">
      {
        talking.talks.map((talk) => (
          <li class="talk-list__item">
            <div class="talk-list__meta">
              <time class="talk-list__date">{talk.date}</time>
              <h2 class="talk-list__title">{talk.title}</h2>
            </div>
            <div class="talk-list__body">
              <p class="talk-list__description">{talk.description}</p>
              <p class="talk-list__venue">{talk.venue}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <HandDrawnDivider />

  <section class="talking-invite" aria-labelledby="talking-invite-title">
    <div class="talking-invite__copy">
      <h2 id="talking-invite-title" class="talking-invite__title">
        {talking.invite.title}
      </h2>
      <p class="talking-invite__body">{talking.invite.body}</p>
      <p class="talking-invite__cta">
        <a
          href={site.footer.contact.linkedin}
          class="home-btn home-btn--primary"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="home-btn__text">
            <span class="home-btn__label">{talking.invite.cta}</span>
            <HandDrawnLinkStroke />
          </span>
        </a>
      </p>
    </div>
    <figure class="talking-invite__figure">
      <img
        class="talking-invite__image"
        src={withBase("/images/talking/open-invitation.png")}
        alt="Collage of an empty chair linked by a hand-drawn red line to a woman gesturing in conversation"
        width="960"
        height="520"
        loading="lazy"
        decoding="async"
      />
    </figure>
  </section>
</Layout>
