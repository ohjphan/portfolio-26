---
import Layout from '../layouts/Layout.astro';
import HandDrawnDivider from '../components/HandDrawnDivider.astro';
import HandDrawnLinkStroke from '../components/HandDrawnLinkStroke.astro';
import SketchLink from '../components/SketchLink.astro';
import { workWith } from '../data/work-with';
import { professionalServiceJsonLd, personJsonLd } from '../lib/seo';
import { withBase } from '../lib/paths';

const { meta, hero, whoFor, offers, proof, contact } = workWith;
---

<Layout
  title={meta.title}
  description={meta.description}
  jsonLd={[professionalServiceJsonLd(), personJsonLd()]}
>
  <article class="work-with">
    <header class="work-with__hero">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1 class="heading-lg work-with__title">{hero.title}</h1>
      <p class="work-with__lede">{hero.lede}</p>
      <p class="work-with__cta">
        <a
          href={contact.linkedin}
          class="home-btn home-btn--primary"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="home-btn__text">
            <span class="home-btn__label">{contact.linkedinLabel}</span>
            <HandDrawnLinkStroke />
          </span>
        </a>
      </p>
    </header>

    <HandDrawnDivider />

    <section class="work-with__section" aria-labelledby="who-for-title">
      <h2 id="who-for-title" class="jessica-band__title">{whoFor.title}</h2>
      <ul class="work-with__list">
        {whoFor.items.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <HandDrawnDivider />

    <section class="work-with__section" aria-labelledby="offers-title">
      <h2 id="offers-title" class="jessica-band__title">{offers.title}</h2>
      <ul class="work-with__offers" role="list">
        {
          offers.items.map((offer) => (
            <li class="work-with__offer">
              <h3 class="work-with__offer-title">{offer.title}</h3>
              <p class="work-with__offer-body">{offer.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <HandDrawnDivider />

    <section class="work-with__section" aria-labelledby="proof-title">
      <h2 id="proof-title" class="jessica-band__title">{proof.title}</h2>
      <p class="work-with__copy">{proof.body}</p>
      <p class="work-with__inline-cta">
        <SketchLink href={withBase(proof.href)}>{proof.cta}</SketchLink>
      </p>
    </section>

    <HandDrawnDivider />

    <section class="work-with__section work-with__closing talking-invite" aria-labelledby="contact-title">
      <div class="talking-invite__copy">
        <h2 id="contact-title" class="jessica-band__title">{contact.title}</h2>
        <p class="work-with__copy">{contact.body}</p>
        <p class="work-with__cta">
          <a
            href={contact.linkedin}
            class="home-btn home-btn--primary"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="home-btn__text">
              <span class="home-btn__label">{contact.linkedinLabel}</span>
              <HandDrawnLinkStroke />
            </span>
          </a>
        </p>
      </div>
      <figure class="talking-invite__figure">
        <img
          class="talking-invite__image"
          src={withBase("/images/talking/open-invitation.png")}
          alt="Collage of an empty chair linked by a hand-drawn red line to a woman gesturing in conversation"
          width="960"
          height="520"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </section>
  </article>
</Layout>
