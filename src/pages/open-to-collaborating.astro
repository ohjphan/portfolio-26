---
import Layout from '../layouts/Layout.astro';
import HandDrawnLinkStroke from '../components/HandDrawnLinkStroke.astro';
import WorkflowSteps from '../components/WorkflowSteps.astro';
import JessicaSignature from '../components/JessicaSignature.astro';
import SketchLink from '../components/SketchLink.astro';
import { workWith } from '../data/work-with';
import { professionalServiceJsonLd, personJsonLd } from '../lib/seo';
import { withBase } from '../lib/paths';

const { meta, letter, collage, testimonials, contact } = workWith;

const paragraphText = (
  paragraph: (typeof letter.beforePoints)[number] | (typeof letter.afterPoints)[number],
) =>
  typeof paragraph === 'string'
    ? paragraph
    : paragraph.segments.map((segment) => segment.text).join('');

const isShortLine = (text: string) => text.length <= 48 && !text.includes('. ');
const pointSteps = letter.points.map((text) => ({ text }));
const testimonialSizer = testimonials.reduce((a, b) =>
  a.length >= b.length ? a : b,
);
---

<Layout
  title={meta.title}
  description={meta.description}
  image="/images/og/open-to-collaborating.png"
  imageAlt="Hands assembling a paper interface collage — Dear people building something"
  jsonLd={[professionalServiceJsonLd(), personJsonLd()]}
>
  <article class="letter">
    <header class="letter__header">
      <h1 class="heading-lg letter__title">{letter.title}</h1>
    </header>

    <div class="letter__body">
      <section class="letter__section">
        {
          letter.beforePoints.map((paragraph) => (
            <p
              class:list={[
                'letter__p',
                isShortLine(paragraphText(paragraph)) && 'letter__p--short',
              ]}
            >
              {paragraph}
            </p>
          ))
        }

        <div class="letter__points">
          <WorkflowSteps steps={pointSteps} />
        </div>

        {
          letter.afterPoints.map((paragraph) => (
            <p
              class:list={[
                'letter__p',
                isShortLine(paragraphText(paragraph)) && 'letter__p--short',
              ]}
            >
              {typeof paragraph === 'string' ? (
                paragraph
              ) : (
                paragraph.segments.map((segment) =>
                  'href' in segment ? (
                    <SketchLink href={segment.href}>{segment.text}</SketchLink>
                  ) : (
                    segment.text
                  ),
                )
              )}
            </p>
          ))
        }
      </section>

      <footer class="letter__close">
        <p class="letter__signoff">
          <JessicaSignature class="letter__signature" />
        </p>
        <div class="letter__cta">
          <a
            href={contact.linkedin}
            class="home-btn home-btn--primary"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="home-btn__text">
              <span class="home-btn__label">{contact.linkedinLabel}</span>
              <HandDrawnLinkStroke />
            </span>
          </a>
          <a
            href={withBase(contact.aboutHref)}
            class="home-btn home-btn--secondary"
          >
            <span class="home-btn__text">
              <span class="home-btn__label">{contact.aboutLabel}</span>
              <HandDrawnLinkStroke />
            </span>
          </a>
        </div>
      </footer>
    </div>
  </article>

  <section class="letter-quotes" aria-label="Things people have said">
    <div class="letter-quotes__shuffle" aria-live="polite">
      <p class="letter-quotes__sizer" aria-hidden="true">
        “{testimonialSizer}”
      </p>
      {
        testimonials.map((quote, index) => (
          <blockquote
            class:list={[
              'letter-quotes__item',
              index === 0 && 'is-active',
            ]}
          >
            <p>“{quote}”</p>
          </blockquote>
        ))
      }
    </div>
  </section>

  <figure class="letter-collage" data-mosaic-scroll>
    <img
      class="letter-collage__image"
      src={withBase(collage.src)}
      alt={collage.alt}
      width={collage.width}
      height={collage.height}
      loading="lazy"
      decoding="async"
    />
  </figure>
</Layout>

<script is:inline>
  (() => {
    const root = document.querySelector('.letter-quotes__shuffle');
    if (!root) return;

    const items = Array.from(
      root.querySelectorAll('.letter-quotes__item'),
    );
    if (items.length < 2) return;

    const reduceMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches;
    if (reduceMotion) return;

    let index = 0;
    const intervalMs = 7000;

    window.setInterval(() => {
      items[index].classList.remove('is-active');
      index = (index + 1) % items.length;
      items[index].classList.add('is-active');
    }, intervalMs);
  })();
</script>
